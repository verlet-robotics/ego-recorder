{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "egorec-viewer",
  "version": "0.1.0",
  "identifier": "com.mateoclean.egorec-viewer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Egorec Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost http://localhost:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/tmp/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["egorec"],
        "mimeType": "application/octet-stream",
        "description": "Egorec Recording File"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": null
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
